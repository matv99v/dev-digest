node_modules/
dist/
# agent-runner ships as a JS GitHub Action — its bundled dist/ MUST be committed
# (GitHub runs action.yml `main: dist/index.js` as-is, with no build step).
!agent-runner/dist/
!agent-runner/dist/**
build/
.next/
out/
coverage/
*.tsbuildinfo
.env
.env.local
.DS_Store
.idea/
.turbo/
.pnpm-store/
*.log
.devdigest/cache/
clones/
playwright-report/
test-results/

# emdash worktree config (local)
.emdash.json

# personal Claude Code instructions, loaded alongside AGENTS.md
CLAUDE.local.md

# pr-self-review local state (per-dev). MUST stay ignored: the file is untracked, so if it
# were visible to `git ls-files --others` it would feed its own diff hash and no PASS could
# ever match on the next run.
.pr-self-review.json
.claude/skills/*-workspace/
