+"use client";
+
+import { useEffect, useState } from "react";
+import type { TraceSummary } from "../../../../../../../../../lib/types";
+import { SEVERITY_LABEL, TRACE_POLL_MS } from "@/constants/severity";
+
+export function TraceStats({ runId }: { runId: string }) {
+  const [stats, setStats] = useState<TraceSummary | null>(null);
+
+  useEffect(() => {
+    const load = async () => {
+      const res = await fetch(
+        `${process.env.NEXT_PUBLIC_API_BASE}/runs/${runId}/trace/summary`
+      );
+      setStats(await res.json());
+    };
+    load();
+    const t = setInterval(load, TRACE_POLL_MS);
+    return () => clearInterval(t);
+  }, [runId]);
+
+  if (!stats) return null;
+  return <div>{SEVERITY_LABEL[stats.topSeverity]}: {stats.count}</div>;
+}
